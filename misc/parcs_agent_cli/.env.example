# ── PARCS cluster ─────────────────────────────────────────────────────────────
# Required: base URL of the PARCS MCP server (Streamable HTTP)
MCP__CLUSTER_URL=http://34.116.216.29:8080

# ── LLM provider ──────────────────────────────────────────────────────────────
# Providers: vertexai | google | anthropic | openai (any OpenAI-compatible endpoint)
LLM__PROVIDER=vertexai
LLM__PROJECT=project-42bf3d0d-188a-4d3d-b56          # your GCP project ID (vertexai)
LLM__LOCATION=us-central1
LLM__TEMPERATURE=0.0            # 0 = deterministic

# Alternatively, use an OpenAI-compatible local endpoint:
# LLM__PROVIDER=openai
# LLM__MODEL_NAME=qwen/qwen3.6-27b
# LLM__BASE_URL=http://localhost:1234/v1
# LLM__API_KEY=lmstudio         # also used by the google and anthropic providers

# ── LangSmith tracing ─────────────────────────────────────────────────────────
LANGSMITH__TRACING_V2=true
LANGSMITH__ENDPOINT=https://api.smith.langchain.com
LANGSMITH__PROJECT=parcs-agent
LANGSMITH__API_KEY=

# ── Agent ─────────────────────────────────────────────────────────────────────
# tool_calling: the model calls the PARCS tools itself; ptc: it calls them from JavaScript
AGENT__MODE=tool_calling
# The settings below apply to ptc only
AGENT__EVAL_TIMEOUT_SECONDS=30.0   # QuickJS VM time per eval; time awaiting tools.* is not counted
AGENT__MAX_PTC_CALLS=256
AGENT__MAX_RESULT_CHARS=4000       # cap on one eval result returned to the model
