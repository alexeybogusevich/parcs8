# ── PARCS cluster ─────────────────────────────────────────────────────────────
# Required: base URL of the PARCS MCP server (Streamable HTTP)
MCP__CLUSTER_URL=http://localhost:8080

# ── LLM defaults (each model below may override provider, base_url, api_key, temperature) ──
# Providers: vertexai | google | anthropic | openai (any OpenAI-compatible endpoint, e.g. OpenRouter)
LLM__PROVIDER=openai
LLM__BASE_URL=https://openrouter.ai/api/v1
LLM__API_KEY=
LLM__TEMPERATURE=0.0

# ── LangSmith tracing ─────────────────────────────────────────────────────────
LANGSMITH__TRACING_V2=true
LANGSMITH__ENDPOINT=https://api.smith.langchain.com
LANGSMITH__PROJECT=parcs-tc-vs-ptc
LANGSMITH__API_KEY=

# ── Experiment ────────────────────────────────────────────────────────────────
# Models as JSON: `id` is the short name used in run ids; the other fields override LLM__*.
# `openrouter_provider` pins every call to one OpenRouter endpoint tag (no fallbacks), and
# `reasoning_effort` sets OpenRouter's reasoning effort (unset: the provider's default). Both are
# recorded in the manifest.
EXPERIMENT__MODELS='[{"id": "gpt6luna", "model_name": "openai/gpt-6-luna", "openrouter_provider": "openai"}, {"id": "haiku55", "model_name": "anthropic/claude-haiku-5.5", "openrouter_provider": "anthropic"}, {"id": "dsv41flash", "model_name": "deepseek/deepseek-v4.1-flash-1017", "openrouter_provider": "deepinfra/fp8"}]'
# EXPERIMENT__FAMILIES='["f1", "f2"]'
# EXPERIMENT__N_GRID='[2, 4, 8, 16, 32]'
# EXPERIMENT__ARMS='["tool_calling", "ptc"]'
# EXPERIMENT__REPS=5
# EXPERIMENT__RECURSION_LIMIT=600
# The only wall-clock limit per run. The pilot's longest successful run took 417 s.
# EXPERIMENT__WALL_BUDGET_SECONDS=3600
# ptc only: QuickJS VM time per eval (time awaiting tools.* is not counted), call budget, result cap
# EXPERIMENT__EVAL_TIMEOUT_SECONDS=30.0
# EXPERIMENT__MAX_PTC_CALLS=256
# EXPERIMENT__MAX_RESULT_CHARS=4000
