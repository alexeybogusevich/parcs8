      "args": {
       "sourceCode": "using System;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Text.Json;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Parcs.Agent.Runtime;\n\npublic class StepJob : IAgentComputation\n{\n    public Task<AgentLayerResult> ExecuteAsync(AgentLayerInput input, CancellationToken ct)\n    {\n        double lo = 0.0, hi = 1.0;\n        if (input.PreviousLayerResults != null && input.PreviousLayerResults.Count > 0)\n        {\n            var outputs = input.GetPreviousOutputs();\n            ulong total = 0;\n            foreach (var s in outputs)\n            {\n                if (s == null) continue;\n                var r = JsonSerializer.Deserialize<StepState>(s);\n                lo = r.Lo; hi = r.Hi; total += r.Count;\n            }\n            double midPrev = (lo + hi) / 2.0;\n            if (total >= 5000000UL) hi = midPrev; else lo = midPrev;\n        }\n        double mid = (lo + hi) / 2.0;\n        ulong count = 0;\n        const ulong M = 16777216UL;\n        unchecked\n        {\n            for (ulong i = (ulong)input.WorkerIndex + 1UL; i <= M; i += (ulong)input.TotalWorkers)\n            {\n                ulong z = i * 0x9E3779B97F4A7C15UL;\n                z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9UL;\n                z = (z ^ (z >> 27)) * 0x94D049BB133111EBUL;\n                z = z ^ (z >> 31);\n                double v = (double)(z % 2147483647UL) / 2147483647.0;\n                if (v <= mid) count++;\n            }\n        }\n        return Task.FromResult(AgentLayerResult.Ok(JsonSerializer.Serialize(new StepState { Lo = lo, Hi = hi, Count = count })));\n    }\n}\n\npublic class FinalJob : IAgentComputation\n{\n    public Task<AgentLayerResult> ExecuteAsync(AgentLayerInput input, CancellationToken ct)\n    {\n        double lo = 0.0, hi = 1.0;\n        ulong total = 0;\n        var outputs = input.GetPreviousOutputs();\n        foreach (var s in outputs)\n        {\n            if (s == null) continue;\n            var r = JsonSerializer.Deserialize<StepState>(s);\n            lo = r.Lo; hi = r.Hi; total += r.Count;\n        }\n        double mid = (lo + hi) / 2.0;\n        if (total >= 5000000UL) hi = mid; else lo = mid;\n        double answer = (lo + hi) / 2.0;\n        return Task.FromResult(AgentLayerResult.Ok(JsonSerializer.Serialize(new { midpoint = answer, count = total, lo, hi })));\n    }\n}\n\npublic class StepState\n{\n    public double Lo { get; set; }\n    public double Hi { get; set; }\n    public ulong Count { get; set; }\n}"
