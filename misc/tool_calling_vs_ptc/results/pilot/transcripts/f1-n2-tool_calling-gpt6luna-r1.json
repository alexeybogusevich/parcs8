     {
      "name": "create_session",
      "args": {
       "sourceCode": "using System;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Text.Json;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Parcs.Agent.Runtime;\n\npublic class IntegralPart : IAgentComputation\n{\n    public Task<AgentLayerResult> ExecuteAsync(AgentLayerInput input, CancellationToken ct)\n    {\n        int k = int.Parse(input.WorkerInput);\n        double a = 8.0 * k / 2.0;\n        double b = 8.0 * (k + 1) / 2.0;\n        const int n = 10000;\n        double h = (b - a) / n;\n        double sum = F(a) + F(b);\n        for (int i = 1; i < n; i++)\n        {\n            double x = a + i * h;\n            sum += (i % 2 == 0 ? 2.0 : 4.0) * F(x);\n        }\n        double value = sum * h / 3.0;\n        return Task.FromResult(AgentLayerResult.Ok(JsonSerializer.Serialize(new PartResult { Value = value })));\n    }\n    private static double F(double x) => Math.Exp(-x / 4.0) * Math.Cos(x + 0.5 * Math.Sin(2.0 * x));\n}\n\npublic class PartResult\n{\n    public double Value { get; set; }\n}\n\npublic class IntegralReduce : IAgentComputation\n{\n    public Task<AgentLayerResult> ExecuteAsync(AgentLayerInput input, CancellationToken ct)\n    {\n        double total = 0.0;\n        for (int j = 0; j < 2; j++)\n        {\n            var outputs = input.GetPreviousOutputs(j);\n            foreach (var json in outputs)\n            {\n                if (json != null)\n                    total += JsonSerializer.Deserialize<PartResult>(json).Value;\n            }\n        }\n        return Task.FromResult(AgentLayerResult.Ok(JsonSerializer.Serialize(new { I = total })));\n    }\n}"
      },
      "id": "call_I7roTxpSW7ux67VvmjcOntnC",
      "type": "tool_call"
     }
